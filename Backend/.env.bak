# ============================================================
#  Door2Door Laundry — Environment Variables
#  LOCAL DEVELOPMENT ONLY — never commit this file to Git!
#  Add .env to your .gitignore
# ============================================================

# ── Database (Clever Cloud MySQL) ─────────────────────────────
# Fill these in from your Clever Cloud dashboard:
#   Add-ons → MySQL → Connection details
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=door2door
# ── Email (Gmail SMTP) ────────────────────────────────────────
GMAIL_USER=binitagvasita@gmail.com
GMAIL_APP_PASSWORD=ftqpgfqkxvzbxcms
OTP_EXPIRY_MINUTES=10
# ── JWT ───────────────────────────────────────────────────────
# Generate a strong random string (min 32 chars).
# Example (run in terminal):  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-secret-key-min-32-chars
JWT_EXPIRY_HOURS=24

# ── Flask ─────────────────────────────────────────────────────
FLASK_ENV=development
# Change to "production" on Render.com

# ── CORS ──────────────────────────────────────────────────────
# Space-separated list of allowed frontend origins.
# Add your Netlify URL here after first deployment.
CORS_ORIGINS=http://127.0.0.1:5500 http://localhost:5500 http://127.0.0.1:5501 http://localhost:5501 http://localhost:3000
# Production example:
# CORS_ORIGINS=https://door2door-laundry.netlify.app
